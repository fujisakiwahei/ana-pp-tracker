# Nuxt dev/build outputs
.output
.data
.nuxt
.nitro
.cache
dist

# Vercel のビルド成果物 (Build Output API)。
# .wrangler と同じ理由でルートに要る (ESLint の gitignore 連携はここしか読まない)。
.vercel

# wrangler の dev/build 成果物。
# apps/api/.gitignore にも書いてあるが、ここにも要る:
# ESLint の gitignore 連携はルートの .gitignore しか読まないため、
# 書かないと wrangler dev を一度動かしただけでバンドル出力を lint しはじめる。
.wrangler

# SCSS のコンパイル済み出力
# 正は app/assets/styles/main.scss。nuxt.config.ts もそちらを参照している。
/main.css
/main.css.map

# Node dependencies
node_modules

# Logs
logs
*.log

# Misc
.DS_Store
.fleet
.idea

# Local env files
.env
.env.*
!.env.example
# wrangler のローカル環境変数 (Supabase のキーが入る)
.dev.vars
!.dev.vars.example
